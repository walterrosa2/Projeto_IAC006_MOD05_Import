# ============================================================
# Classificador Contabil - variaveis de ambiente
# Copie para .env e preencha. NUNCA versionar o .env real.
# ============================================================

# --- Provedor de IA ---------------------------------------
# Valores aceitos: mock | anthropic | openai | gemini
# "mock" permite rodar a aplicacao inteira sem chave de API.
# Padrao das aulas: gemini (chave gratuita criada no Google AI Studio).
AI_PROVIDER=gemini

# Modelo usado pelo provedor selecionado.
# anthropic -> claude-sonnet-5
# openai    -> gpt-4o-mini
# gemini    -> gemini-3.6-flash
AI_MODEL=gemini-3.6-flash

# Chaves (preencher apenas a do provedor em uso)
# ALUNO: cole sua chave do Google AI Studio logo depois do sinal de igual,
# sem aspas e sem espacos. Exemplo:  GEMINI_API_KEY=AIzaSy...
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Timeout (segundos) e tentativas para chamadas de IA
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3

# --- OCR de PDFs digitalizados ----------------------------
# Quando o PDF nao tem camada de texto, transcreve via IA multimodal
# (usa o AI_PROVIDER e a AI_MODEL acima). Custa tokens: cada pagina
# vira imagem. Indisponivel no provedor mock.
OCR_ENABLED=false
# Teto de paginas enviadas por documento.
OCR_MAX_PAGES=10

# --- Regras de negocio ------------------------------------
# Confianca minima do classificador documental (abaixo disso -> OUTRO)
MIN_CLASSIFICATION_CONFIDENCE=0.70
# Confianca minima da IA contabil (abaixo disso -> warning no lancamento)
MIN_ACCOUNTING_CONFIDENCE=0.60
# Numero maximo de exemplos de lancamento injetados no prompt
MAX_EXAMPLES_IN_PROMPT=5
# Numero maximo de correcoes anteriores injetadas no prompt
MAX_CORRECTIONS_IN_PROMPT=5
# Numero maximo de contas do plano de contas injetadas no prompt
MAX_ACCOUNTS_IN_PROMPT=400

# --- Infraestrutura local ---------------------------------
DATABASE_URL=sqlite:///data/app.db
LOG_LEVEL=INFO
LOG_DIR=logs
EXPORT_DIR=data/exports
